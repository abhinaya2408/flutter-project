<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (this file lives in `src/debug`).

  The local Firebase emulator suite is plaintext HTTP / h2c, and Android refuses
  cleartext by default. Rather than switching cleartext on for every host, this
  permits it for the emulator destinations alone:

    10.0.2.2  — an Android *emulator*'s alias for the host machine's loopback
    127.0.0.1 — the device itself, used with `adb reverse tcp:8080 tcp:8080`
                (the route a physical device needs)
    localhost — the same, by name

  Everything else keeps the platform default, and because this is a debug source
  set it is never merged into a release build: shipped apps still refuse
  cleartext everywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
