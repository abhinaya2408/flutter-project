rules_version = '2';

// Storage rules for the optional cake reference photos.
//
// `js/customize.js` validated the pick as JPG/JPEG/PNG and at most 2 MB before
// storing it as a Data URL on the order. The Flutter app uploads the same file
// to `reference_images/{orderId}/{fileName}` instead, and these rules enforce
// the same accept list and size limit server-side.
service firebase.storage {
  match /b/{bucket}/o {

    match /reference_images/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png)');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
