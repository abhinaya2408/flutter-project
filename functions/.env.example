# ---------------------------------------------------------------------------
# Crumb & Cream — WhatsApp OTP backend configuration
#
# Copy to `.env` for the local emulator, or set the same keys as Cloud
# Functions runtime environment variables / Secret Manager secrets.
#
# THIS FILE IS AN EXAMPLE. It must never contain real credentials.
# Everything here lives on the server only — none of it may be shipped inside
# the Flutter app.
# ---------------------------------------------------------------------------

# Which verification provider to use: `twilio` (real) or `mock` (emulator only,
# and only together with FUNCTIONS_EMULATOR=true or NODE_ENV=test).
OTP_PROVIDER=twilio

# Region the callable Functions are deployed to. The Flutter client must use
# the same region (AppConfig.otpFunctionsRegion).
OTP_FUNCTIONS_REGION=us-central1

# Country code assumed for numbers typed without one (E.164 prefix).
OTP_DEFAULT_COUNTRY_CODE=+91

# Optional: default WhatsApp template locale, e.g. `en`.
OTP_LOCALE=en

# Refuse to run if App Check tokens are missing (enable after App Check is set
# up for the app; leave false until then).
OTP_ENFORCE_APP_CHECK=false

# ---- Twilio Verify (required when OTP_PROVIDER=twilio) --------------------
# Console: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Prefer an API Key + Secret over the account Auth Token.
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your-api-key-secret
# Or, instead of the API key pair:
# TWILIO_AUTH_TOKEN=your-account-auth-token
# Console: Twilio → Verify → Services → your service SID
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional rate-limit overrides ----------------------------------------
# OTP_SEND_PER_PHONE_LIMIT=3
# OTP_SEND_PER_PHONE_WINDOW_SECONDS=900
# OTP_SEND_COOLDOWN_SECONDS=60
# OTP_SEND_PER_IP_LIMIT=10
# OTP_SEND_PER_IP_WINDOW_SECONDS=3600
# OTP_VERIFY_PER_PHONE_LIMIT=5
# OTP_VERIFY_PER_PHONE_WINDOW_SECONDS=600
# OTP_CODE_TTL_SECONDS=600

# ---- Emulator-only mock provider ------------------------------------------
# Required when OTP_PROVIDER=mock. The mock provider refuses to construct
# without it, and refuses to construct outside the emulator / tests at all.
# OTP_MOCK_CODE=000000
